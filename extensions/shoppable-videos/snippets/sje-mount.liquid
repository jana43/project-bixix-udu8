{%- assign sje_media = media | default: widget.media -%}
{%- assign sje_an = app.metafields.shoppable_videos_plan.entitlements.value.analytics -%}
<div
  id="sje-{{ layout }}-{{ widget_id }}"
  class="sje-mount sje-mount--{{ layout }}"
  data-sje-widget-id="{{ widget_id }}"
  {%- if settings != blank -%}
    data-sje-settings="{{ settings | json | escape }}"
  {%- endif -%}
  {%- if product_id != blank %} data-sje-product-id="{{ product_id }}"{% endif -%}
  {%- if layout == 'floating-bubble' %} style="display:block;"{% elsif layout == 'banner' %} style="display:block;position:absolute;inset:0;"{% else %} style="display:block;height:100%;"{% endif -%}
>
  {%- assign sje_sp = 'var(--sje-standard-spacing, 8px)' -%}
  {%- assign sje_fs = 'var(--sje-standard-font-size, 14px)' -%}
  {%- assign sje_radius = settings.card_radius | default: 100 | divided_by: 100.0 -%}
  {%- capture sje_bone -%}
    background:rgba(0,0,0,0.08);border-radius:calc({{ sje_sp }} * {{ sje_radius }});font-size:0;line-height:0;
  {%- endcapture -%}
  {%- if layout == 'floating-bubble' -%}
  {%- elsif layout == 'story-bar' -%}
    {%- assign sje_unit = 'var(--sje-story-unit, 8px)' -%}
    {%- assign sje_circle_mult = settings.circle_scale | default: 900 | divided_by: 100.0 -%}
    {%- assign sje_align = settings.row_alignment | default: 'center' -%}
    {%- if sje_align == 'left' -%}
      {%- assign sje_justify = 'flex-start' -%}
    {%- elsif sje_align == 'right' -%}
      {%- assign sje_justify = 'safe flex-end' -%}
    {%- else -%}
      {%- assign sje_justify = 'safe center' -%}
    {%- endif -%}
    {%- capture sje_row -%}display:flex;align-items:flex-start;justify-content:{{ sje_justify }};gap:calc({{ sje_sp }} * 2);overflow:hidden;{%- endcapture -%}
    {%- capture sje_bone_column -%}flex:0 0 calc({{ sje_unit }} * {{ sje_circle_mult }});display:flex;flex-direction:column;align-items:center;gap:calc({{ sje_sp }} * 0.75);{%- endcapture -%}
    {%- capture sje_bone_shape -%}flex:0 0 auto;width:100%;height:calc({{ sje_unit }} * {{ sje_circle_mult }});border-radius:50%;{%- endcapture -%}
    {%- capture sje_bone_caption -%}flex:0 0 auto;width:80%;height:calc({{ sje_fs }} * 0.75 * 1.3);{%- endcapture -%}
  {%- elsif layout == 'stacked' -%}
    {%- capture sje_row -%}position:relative;height:75vh;overflow:hidden;{%- endcapture -%}
  {%- elsif layout == 'banner' -%}
  {%- elsif layout == 'product-videos' -%}
    {%- assign sje_columns = settings.columns | default: 4 -%}
    {%- capture sje_card_width -%}calc((100% - calc({{ sje_sp }} * 1.5) * (var(--sje-across-count, {{ sje_columns }}) - 1)) / var(--sje-across-count, {{ sje_columns }})){%- endcapture -%}
    {%- capture sje_row -%}display:flex;align-items:flex-start;gap:calc({{ sje_sp }} * 1.5);overflow:hidden;{%- endcapture -%}
    {%- capture sje_bone_shape -%}flex:0 0 auto;width:{{ sje_card_width }};height:auto;aspect-ratio:9 / 16;{%- endcapture -%}
  {%- elsif layout == 'grid' -%}
    {%- assign sje_columns = settings.columns | default: 4 -%}
    {%- capture sje_row -%}display:grid;grid-template-columns:repeat(var(--sje-across-count, {{ sje_columns }}), minmax(0, 1fr));gap:calc({{ sje_sp }} * 1.5);{%- endcapture -%}
    {%- capture sje_bone_shape -%}width:100%;height:auto;aspect-ratio:9 / 16;{%- endcapture -%}
  {%- else -%}
    {%- assign sje_arrows = settings.arrow_position | default: 'center' -%}
    {%- if sje_arrows == 'hidden' -%}
      {%- capture sje_row_height -%}100%{%- endcapture -%}
    {%- else -%}
      {%- assign sje_arrow_mult = settings.arrow_scale | default: 500 | divided_by: 100.0 -%}
      {%- capture sje_row_height -%}calc(100% - {{ sje_sp }} * 1.5 - {{ sje_sp }} * {{ sje_arrow_mult }}){%- endcapture -%}
    {%- endif -%}
    {%- capture sje_row -%}display:flex;align-items:stretch;gap:calc({{ sje_sp }} * 1.5);height:{{ sje_row_height }};overflow:hidden;{%- endcapture -%}
    {%- capture sje_bone_shape -%}flex:0 0 auto;height:100%;width:auto;aspect-ratio:9 / 16;{%- endcapture -%}
  {%- endif -%}
  {%- unless layout == 'floating-bubble' or layout == 'banner' -%}
  <div class="sje-widget__items" style="{{ sje_row }}" aria-hidden="true">
    {%- if layout == 'stacked' -%}
      {%- if sje_media.size >= 5 -%}
        {%- assign sje_bone_limit = 5 -%}
      {%- elsif sje_media.size >= 3 -%}
        {%- assign sje_bone_limit = 3 -%}
      {%- else -%}
        {%- assign sje_bone_limit = 1 -%}
      {%- endif -%}
    {%- elsif layout == 'product-videos' -%}
      {%- assign sje_bone_limit = settings.columns | default: 4 | times: 2 -%}
    {%- elsif layout == 'grid' -%}
      {%- assign sje_bone_limit = settings.videos_shown | default: 8 -%}
    {%- else -%}
      {%- assign sje_bone_limit = 8 -%}
    {%- endif -%}
    {%- for sje_bone_item in sje_media limit: sje_bone_limit -%}
      {%- if layout == 'stacked' -%}
        {%- assign sje_half = sje_bone_limit | minus: 1 | divided_by: 2 -%}
        {%- assign sje_slot = forloop.index0 | minus: sje_half | plus: 2 -%}
        {%- case sje_slot -%}
          {%- when 2 -%}
            {%- assign sje_card = 'translate(-50%, -50%);z-index:2' -%}
          {%- when 1 -%}
            {%- assign sje_card = 'translate(-50%, -50%) translateX(-72%) scale(0.82);z-index:1;filter:brightness(0.62)' -%}
          {%- when 3 -%}
            {%- assign sje_card = 'translate(-50%, -50%) translateX(72%) scale(0.82);z-index:1;filter:brightness(0.62)' -%}
          {%- when 0 -%}
            {%- assign sje_card = 'translate(-50%, -50%) translateX(-131.04%) scale(0.6724);z-index:0;filter:brightness(0.62)' -%}
          {%- else -%}
            {%- assign sje_card = 'translate(-50%, -50%) translateX(131.04%) scale(0.6724);z-index:0;filter:brightness(0.62)' -%}
        {%- endcase -%}
        <div
          class="sje-widget__item sje-bone sje-bone--stacked"
          style="{{ sje_bone }}position:absolute;inset-inline-start:50%;top:50%;height:100%;max-width:72%;aspect-ratio:9 / 16;transform:{{ sje_card }};"
        >&nbsp;</div>
      {%- elsif layout == 'story-bar' -%}
        <div class="sje-bone-column" style="{{ sje_bone_column }}">
          <div class="sje-widget__item sje-bone" style="{{ sje_bone }}{{ sje_bone_shape }}">&nbsp;</div>
          {%- unless settings.show_titles == false -%}
            <div class="sje-widget__item sje-bone sje-bone--caption" style="{{ sje_bone }}{{ sje_bone_caption }}">&nbsp;</div>
          {%- endunless -%}
        </div>
      {%- else -%}
        <div class="sje-widget__item sje-bone" style="{{ sje_bone }}{{ sje_bone_shape }}">&nbsp;</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- endunless -%}
</div>
<script>
  (function () {
    var SJE = (window.SJE = window.SJE || {});
    SJE.widgets = SJE.widgets || {};
    SJE.scripts = SJE.scripts || {};
    SJE.plan = SJE.plan || { analytics: {{ sje_an | json }} };
    {%- if sje_an -%}
    SJE.ingest = SJE.ingest || {
      host: "http://127.0.0.1:3559",
      cell: "shoppable_videos",
      shop: {{ shop.permanent_domain | json }},
      country: {{ localization.country.iso_code | json }}
    };
    {%- endif -%}
    SJE.widgets[{{ widget_id | json }}] = {
      id: {{ widget_id | json }},
      name: {{ widget.name | json }},
      layout: {{ widget.layout | json }},
      enabled: {{ widget.enabled | json }},
      updatedAt: {{ widget.updatedAt | json }},
      media: {% if sje_media.size > 0 %}{{ sje_media | json }}{% else %}[]{% endif %}
    };
    {%- if sje_media.size == 0 -%}
      {%- for sje_media_id in widget.mediaIds -%}
        {%- assign sje_media_key = 'media_' | append: sje_media_id -%}
        {%- assign sje_one = app.metafields.shoppable_videos[sje_media_key].value -%}
        {%- if sje_one != blank and sje_one.deactivated != true and sje_one.enabled != false -%}
          SJE.widgets[{{ widget_id | json }}].media.push({{ sje_one | json }});
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    var LAYOUT = {{ layout | json }};
    var SRC = {{ script | asset_url | json }};
    if (SJE.scripts[LAYOUT]) return;
    SJE.scripts[LAYOUT] = "idle";
    var EVENTS = ["mouseover", "pointerdown", "keydown", "touchstart", "wheel", "scroll"];
    function load() {
      if (SJE.scripts[LAYOUT] !== "idle") return;
      SJE.scripts[LAYOUT] = "loading";
      EVENTS.forEach(function (name) {
        window.removeEventListener(name, load);
      });
      var el = document.createElement("script");
      el.src = SRC;
      el.defer = true;
      el.onerror = function () { SJE.scripts[LAYOUT] = "error"; };
      document.head.appendChild(el);
    }
    SJE.loaders = SJE.loaders || {};
    SJE.loaders[LAYOUT] = load;
    SJE.load = function (layout) {
      var loader = SJE.loaders[layout];
      if (loader) loader();
    };
    {%- if request.design_mode or settings.lazy_load == false -%}
      load();
    {%- else -%}
      EVENTS.forEach(function (name) {
        window.addEventListener(name, load, { once: true, passive: true });
      });
    {%- endif -%}
  })();
</script>
