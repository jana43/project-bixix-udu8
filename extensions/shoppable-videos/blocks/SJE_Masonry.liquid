{% render 'sje-widget', layout: 'masonry', widget_id: block.settings.widget_id, padding: block.settings.padding, heading_alignment: block.settings.heading_alignment, heading_size: block.settings.heading_size, heading_color: block.settings.heading_color %}

{% schema %}
{
  "name": "Videos — Masonry",
  "target": "section",
  "stylesheet": "sje-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget ID",
      "info": "The 6-digit ID shown under the widget's name in the app."
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Padding",
      "info": "How much room the widget leaves at the sides.",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "none", "label": "None" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 14,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to use the theme's own heading color."
    }
  ]
}
{% endschema %}
