{%- assign sje_key = 'widget_' | append: block.settings.widget_id -%}
{%- assign sje_widget = app.metafields.shoppable_videos[sje_key].value -%}
{%- assign sje_plan = app.metafields.shoppable_videos_plan.entitlements.value -%}
{%- assign sje_live = sje_widget.media | reject: 'deactivated', true | reject: 'enabled', false -%}
{%- assign sje_locked = true -%}{%- if sje_plan.layouts contains 'grid' -%}{%- assign sje_locked = false -%}{%- endif -%}
{%- assign sje_sp = 'var(--sje-standard-spacing, 8px)' -%}
{%- if block.settings.widget_id == blank -%}
  {% render 'sje-notice' %}
{%- elsif sje_widget == blank -%}
  {% render 'sje-notice', reason: 'not-found', widget_id: block.settings.widget_id %}
{%- elsif sje_widget.enabled == false -%}
  {% render 'sje-notice', reason: 'off', name: sje_widget.name %}
{%- elsif sje_locked -%}
  {% render 'sje-notice', reason: 'locked', name: sje_widget.name %}
{%- elsif sje_widget.deactivated -%}
  {% render 'sje-notice', reason: 'paused', name: sje_widget.name %}
{%- elsif sje_live.size == 0 -%}
  {% render 'sje-notice', reason: 'empty', name: sje_widget.name %}
{%- else -%}
  <div
    class="sje-widget sje-widget--grid sje-widget--pad-{{ block.settings.padding | default: 'medium' }}"
    style="
      --sje-across-desktop:{{ block.settings.columns | default: 4 }};
      --sje-across-mobile:{{ block.settings.columns_mobile | default: 2 }};
      margin:calc({{ sje_sp }} * 3) auto;
    "
  >
    {%- if block.settings.show_heading != false -%}
      {% render 'sje-heading', text: sje_widget.name, settings: block.settings %}
    {%- endif -%}
    {% render 'sje-mount',
      layout: 'grid',
      media: sje_live,
      script: 'sje-grid.js',
      widget_id: block.settings.widget_id,
      widget: sje_widget,
      settings: block.settings
    %}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Videos — Grid",
  "target": "section",
  "stylesheet": "sje-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget ID",
      "info": "The 6-digit ID shown under the widget's name in the app."
    },
    {
      "type": "checkbox",
      "id": "shuffle",
      "label": "Shuffle videos",
      "info": "Play this widget's videos in a random order, different for every visitor. Overrides the order you arranged in the app.",
      "default": false
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Padding",
      "info": "How much room the widget leaves at the sides.",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "none", "label": "None" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "info": "The widget's name, from the app. Turn it off when the section around this block already has a title.",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading font size",
      "info": "A multiple of the widget's standard text size, so it scales down on phones along with everything else.",
      "min": 100,
      "max": 400,
      "step": 25,
      "unit": "x",
      "default": 175
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to use the theme's own heading color."
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "info": "Videos are 9:16, so more columns means taller, narrower cards. Eight across a full-width section is about a 100px video.",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "info": "Set separately because it is a judgement, not arithmetic — nothing about four across a desktop says what a phone should do.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "videos_shown",
      "label": "Videos shown",
      "info": "The rest sit behind a Show more button. A count rather than a number of rows, so the same videos are shown on a phone as on a desktop and only the wrapping changes.",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "info": "A multiple of the widget's standard spacing, so it stays in proportion on a phone rather than staying put while the card shrinks. 100 is 8px on a desktop; 0 is square corners.",
      "min": 0,
      "max": 400,
      "step": 25,
      "unit": "x",
      "default": 100
    },
    {
      "type": "header",
      "content": "Videos"
    },
    {
      "type": "select",
      "id": "preview_mode",
      "label": "Card preview",
      "info": "Videos autoplay muted while the card is on screen. Images fetch nothing but the poster, which matters more here than in any other layout — a grid can put twenty clips on screen at once. Opening a card plays the full video either way.",
      "options": [
        { "value": "video", "label": "Playing video" },
        { "value": "image", "label": "Still image" }
      ],
      "default": "video"
    },
    {
      "type": "checkbox",
      "id": "lazy_load",
      "label": "Load cards only when user interact",
      "info": "On, nothing is downloaded until the shopper moves, taps or scrolls, and each card then waits until it is on screen. Turn it off only for a short grid near the top of the page — on a long one it fetches every clip at once.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticker_on_preview",
      "label": "Show product sticker on the cards",
      "info": "The product badge over each video in the grid. The full-screen player is set separately, below.",
      "default": true
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "player_products",
      "label": "Products in the full-screen video",
      "info": "How the video that opens when a shopper taps a card shows its tagged products.",
      "options": [
        { "value": "sticker", "label": "Sticker on the video" },
        { "value": "free-scroll", "label": "Scrolling product row" },
        { "value": "hidden", "label": "Hidden" }
      ],
      "default": "sticker"
    }
  ]
}
{% endschema %}
