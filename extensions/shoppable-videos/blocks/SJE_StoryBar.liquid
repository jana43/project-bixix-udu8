{%- assign sje_key = 'widget_' | append: block.settings.widget_id -%}
{%- assign sje_widget = app.metafields.shoppable_videos[sje_key].value -%}
{%- assign sje_plan = app.metafields.shoppable_videos_plan.entitlements.value -%}
{%- assign sje_live = sje_widget.media | reject: 'deactivated', true | reject: 'enabled', false -%}
{%- assign sje_locked = true -%}{%- if sje_plan.layouts contains 'story-bar' -%}{%- assign sje_locked = false -%}{%- endif -%}
{%- assign sje_sp = 'var(--sje-standard-spacing, 8px)' -%}
{%- if block.settings.widget_id == blank -%}
  {% render 'sje-notice' %}
{%- elsif sje_widget == blank -%}
  {% render 'sje-notice', reason: 'not-found', widget_id: block.settings.widget_id %}
{%- elsif sje_widget.enabled == false -%}
  {% render 'sje-notice', reason: 'off', name: sje_widget.name %}
{%- elsif sje_locked -%}
  {% render 'sje-notice', reason: 'locked', name: sje_widget.name %}
{%- elsif sje_widget.deactivated -%}
  {% render 'sje-notice', reason: 'paused', name: sje_widget.name %}
{%- elsif sje_live.size == 0 -%}
  {% render 'sje-notice', reason: 'empty', name: sje_widget.name %}
{%- else -%}
  <div
    class="sje-widget sje-widget--story-bar sje-widget--pad-{{ block.settings.padding | default: 'medium' }}"
    style="margin:calc({{ sje_sp }} * 3) auto;"
  >
    {%- if block.settings.show_heading != false -%}
      {% render 'sje-heading', text: sje_widget.name, settings: block.settings %}
    {%- endif -%}
    {% render 'sje-mount',
      layout: 'story-bar',
      media: sje_live,
      script: 'sje-stories.js',
      widget_id: block.settings.widget_id,
      widget: sje_widget,
      settings: block.settings
    %}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Videos — Story bar",
  "target": "section",
  "stylesheet": "sje-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget ID",
      "info": "The 6-digit ID shown under the widget's name in the app."
    },
    {
      "type": "checkbox",
      "id": "shuffle",
      "label": "Shuffle videos",
      "info": "Play this widget's videos in a random order, different for every visitor. Overrides the order you arranged in the app.",
      "default": false
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Padding",
      "info": "How much room the widget leaves at the sides.",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "none", "label": "None" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "info": "The widget's name, from the app. Turn it off when the section around this block already has a title.",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading font size",
      "info": "A multiple of the widget's standard text size, so it scales down on phones along with everything else.",
      "min": 100,
      "max": 400,
      "step": 25,
      "unit": "x",
      "default": 175
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to use the theme's own heading color."
    },
    {
      "type": "header",
      "content": "Circles"
    },
    {
      "type": "range",
      "id": "circle_scale",
      "label": "Circle size",
      "info": "900 is 72px on a desktop and 81px on a phone — circles are the one thing in this widget that get bigger on a small screen, not smaller.",
      "min": 500,
      "max": 2000,
      "step": 50,
      "unit": "x",
      "default": 900
    },
    {
      "type": "select",
      "id": "ring_style",
      "label": "Ring",
      "options": [
        { "value": "gradient", "label": "Gradient" },
        { "value": "solid", "label": "Solid color" },
        { "value": "none", "label": "None" }
      ],
      "default": "gradient"
    },
    {
      "type": "color",
      "id": "ring_from",
      "label": "Ring color",
      "info": "The only color used for a solid ring, and the start of a gradient one.",
      "default": "#f5a623"
    },
    {
      "type": "color",
      "id": "ring_to",
      "label": "Ring gradient end",
      "info": "Ignored unless Ring is set to Gradient.",
      "default": "#d6249f"
    },
    {
      "type": "range",
      "id": "ring_scale",
      "label": "Ring thickness",
      "info": "A multiple of the circle's own unit, so it stays in proportion as the circle scales. 50 is 4px on a desktop.",
      "min": 25,
      "max": 150,
      "step": 25,
      "unit": "x",
      "default": 50
    },
    {
      "type": "select",
      "id": "preview_mode",
      "label": "Circle preview",
      "info": "Videos autoplay muted while the circle is on screen. Images fetch nothing but the poster, which is much lighter on a long row or a slow connection. Opening a circle plays the full video either way.",
      "options": [
        { "value": "video", "label": "Playing video" },
        { "value": "image", "label": "Still image" }
      ],
      "default": "video"
    },
    {
      "type": "checkbox",
      "id": "lazy_load",
      "label": "Load circles only when user interact",
      "info": "On, nothing is downloaded until the shopper moves, taps or scrolls, and each circle then waits until it is on screen. Turn it off for a short bar near the top of the page, where the circles are visible immediately and watching them assemble reads as a stutter — but it costs page speed, and on a long row it fetches every clip at once.",
      "default": true
    },
    {
      "type": "select",
      "id": "row_alignment",
      "label": "Circle alignment",
      "info": "Only visible when there are too few circles to fill the width — a row long enough to scroll has no spare space.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_titles",
      "label": "Show video titles",
      "info": "A one-line caption under each circle.",
      "default": true
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "player_products",
      "label": "Products in the full-screen video",
      "options": [
        { "value": "sticker", "label": "Sticker on the video" },
        { "value": "free-scroll", "label": "Scrolling product row" },
        { "value": "hidden", "label": "Hidden" }
      ],
      "default": "sticker"
    }
  ]
}
{% endschema %}
