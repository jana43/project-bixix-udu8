{%- assign sje_key = 'widget_' | append: block.settings.widget_id -%}
{%- assign sje_widget = app.metafields.shoppable_videos[sje_key].value -%}
{%- assign sje_plan = app.metafields.shoppable_videos_plan.entitlements.value -%}
{%- assign sje_live = sje_widget.media | reject: 'deactivated', true | reject: 'enabled', false -%}
{%- assign sje_locked = true -%}{%- if sje_plan.layouts contains 'banner' -%}{%- assign sje_locked = false -%}{%- endif -%}
{%- assign sje_sp = 'var(--sje-standard-spacing, 8px)' -%}
{%- if block.settings.widget_id == blank -%}
  {% render 'sje-notice' %}
{%- elsif sje_widget == blank -%}
  {% render 'sje-notice', reason: 'not-found', widget_id: block.settings.widget_id %}
{%- elsif sje_widget.enabled == false -%}
  {% render 'sje-notice', reason: 'off', name: sje_widget.name %}
{%- elsif sje_locked -%}
  {% render 'sje-notice', reason: 'locked', name: sje_widget.name %}
{%- elsif sje_widget.deactivated -%}
  {% render 'sje-notice', reason: 'paused', name: sje_widget.name %}
{%- elsif sje_live.size == 0 -%}
  {% render 'sje-notice', reason: 'empty', name: sje_widget.name %}
{%- else -%}
  {%- assign sje_height = block.settings.banner_height | default: 60 -%}
  {%- assign sje_ratio = block.settings.banner_ratio | default: '16/9' -%}
  {%- if sje_ratio == 'fixed' -%}
    {%- capture sje_box -%}height:{{ sje_height }}vh;{%- endcapture -%}
  {%- else -%}
    {%- capture sje_box -%}aspect-ratio:{{ sje_ratio }};{%- endcapture -%}
  {%- endif -%}
  {%- assign sje_pos = block.settings.content_position | default: 'middle-left' -%}
  {%- assign sje_cell = sje_pos | split: '-' -%}
  {%- assign sje_band = sje_cell[0] -%}
  {%- assign sje_align = sje_cell[1] -%}
  {%- if sje_band == 'top' -%}
    {%- assign sje_items = 'flex-start' -%}
  {%- elsif sje_band == 'bottom' -%}
    {%- assign sje_items = 'flex-end' -%}
  {%- else -%}
    {%- assign sje_items = 'center' -%}
  {%- endif -%}
  {%- if sje_align == 'center' -%}
    {%- assign sje_justify = 'center' -%}
  {%- elsif sje_align == 'right' -%}
    {%- assign sje_justify = 'flex-end' -%}
  {%- else -%}
    {%- assign sje_justify = 'flex-start' -%}
  {%- endif -%}
  {%- assign sje_measure_name = block.settings.content_width | default: 'medium' -%}
  {%- if sje_measure_name == 'small' -%}
    {%- assign sje_measure = '32ch' -%}
  {%- elsif sje_measure_name == 'large' -%}
    {%- assign sje_measure = '68ch' -%}
  {%- else -%}
    {%- assign sje_measure = '48ch' -%}
  {%- endif -%}
  {%- assign sje_scrim = block.settings.overlay_opacity | default: 35 | divided_by: 100.0 -%}
  {%- assign sje_radius = block.settings.card_radius | default: 100 | divided_by: 100.0 -%}
  {%- assign sje_text = block.settings.text_color | default: '#ffffff' -%}
  {%- assign heading_mult = block.settings.heading_scale | default: 300 | divided_by: 100.0 -%}
  {%- assign sje_bu = 'var(--sje-banner-unit, var(--sje-standard-font-size, 14px))' -%}
  <div
    class="sje-widget sje-widget--banner sje-widget--pad-{{ block.settings.padding | default: 'none' }}"
    style="position:relative;{{ sje_box }}overflow:hidden;background:{{ block.settings.banner_background | default: '#000000' }};border-radius:calc({{ sje_sp }} * {{ sje_radius }});margin:calc({{ sje_sp }} * 3) auto;"
  >
    {% render 'sje-mount',
      layout: 'banner',
      media: sje_live,
      script: 'sje-banner.js',
      widget_id: block.settings.widget_id,
      widget: sje_widget,
      settings: block.settings
    %}
    <div
      class="sje-banner__content"
      style="position:absolute;inset:0;display:flex;align-items:{{ sje_items }};justify-content:{{ sje_justify }};padding:calc({{ sje_bu }} * 2);background:rgba(0,0,0,{{ sje_scrim }});pointer-events:none;"
    >
      <div
        class="sje-banner__copy"
        style="max-width:min({{ sje_measure }}, 100%);font-size:{{ sje_bu }};color:{{ sje_text }};text-align:{{ sje_align }};pointer-events:auto;"
      >
        {%- if block.settings.subheading != blank -%}
          <p
            class="sje-banner__subheading"
            style="margin:0 0 calc({{ sje_bu }} * 0.6);font-size:calc({{ sje_bu }} * 0.95);letter-spacing:0.08em;text-transform:uppercase;font-weight:600;opacity:0.85;"
          >{{ block.settings.subheading }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2
            class="sje-banner__heading sje-widget__heading"
            style="--sje-heading-font-size:calc({{ sje_bu }} * {{ heading_mult }});margin:0 0 calc({{ sje_bu }} * 0.8);font-size:var(--sje-heading-font-size);line-height:1.15;color:inherit;"
          >{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.body != blank -%}
          <p
            class="sje-banner__body"
            style="margin:0 0 calc({{ sje_bu }} * 1.5);font-size:calc({{ sje_bu }} * 1.1);line-height:1.5;"
          >{{ block.settings.body }}</p>
        {%- endif -%}
        {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}
          <a
            class="sje-banner__cta"
            href="{{ block.settings.cta_link }}"
            style="display:inline-block;padding:calc({{ sje_bu }} * 0.8) calc({{ sje_bu }} * 1.7);border-radius:calc({{ sje_bu }} * 0.5);background:{{ block.settings.cta_background | default: '#ffffff' }};color:{{ block.settings.cta_text_color | default: '#111111' }};font-family:inherit;font-size:calc({{ sje_bu }} * 1);font-weight:600;line-height:1.4;text-decoration:none;"
          >{{ block.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Videos — Banner",
  "target": "section",
  "stylesheet": "sje-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget ID",
      "info": "The 6-digit ID shown under the widget's name in the app. The banner plays this widget's first video. Turn on Shuffle in the app to play a random one instead."
    },
    {
      "type": "checkbox",
      "id": "shuffle",
      "label": "Shuffle videos",
      "info": "Play a random one of this widget's videos, and move on to the next as each ends, instead of always showing the first.",
      "default": false
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Padding",
      "info": "How much room the banner leaves at the sides.",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "none", "label": "None" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "banner_ratio",
      "label": "Shape",
      "info": "The banner's height comes from its width and this shape, so it stays the same proportion on every screen. Choose Fixed height to set a share of the screen instead.",
      "options": [
        { "value": "21/9", "label": "Ultra-wide (21:9)" },
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "3/2", "label": "Landscape (3:2)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "9/16", "label": "Full portrait (9:16)" },
        { "value": "fixed", "label": "Fixed height" }
      ],
      "default": "16/9"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Fixed height",
      "info": "Ignored unless Shape is set to Fixed height. A share of the screen's height.",
      "min": 25,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 60
    },
    {
      "type": "select",
      "id": "banner_fit",
      "label": "Video fit",
      "info": "Fill crops whatever does not fit the shape. Fit shows the whole frame with bars at the sides — usually what you want for a phone-shot vertical video in a wide banner, where Fill would show a narrow strip of the middle.",
      "options": [
        { "value": "cover", "label": "Fill the banner (crop)" },
        { "value": "contain", "label": "Fit the whole video" }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "banner_background",
      "label": "Background",
      "info": "Shows behind the video — the bars at the sides when Video fit is set to Fit the whole video.",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "info": "A multiple of the widget's standard spacing; 100 is 8px on a desktop, and 0 is square corners.",
      "min": 0,
      "max": 400,
      "step": 25,
      "unit": "x",
      "default": 100
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Text position",
      "info": "Where the heading, paragraph and button sit on the banner. The product sticker is placed on the far side of whichever you pick, so the two never overlap.",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Text width",
      "info": "How wide the text column is allowed to get before it wraps. Narrower reads better; wider fits more on one line. It never exceeds the banner, so a phone is unaffected.",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "A short line above the heading — a collection name, a season, an offer."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Paragraph"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading font size",
      "info": "A multiple of the widget's standard text size, so it scales down on phones along with everything else.",
      "min": 100,
      "max": 600,
      "step": 25,
      "unit": "x",
      "default": 300
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Applies to the heading, subheading and paragraph together. The button has its own colors below.",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Darken the video",
      "info": "A shade over the video, behind the text. Video is moving and unpredictable, so light text on it usually needs some of this to stay readable — raise it if a bright frame washes the heading out.",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "info": "The button appears only when it has both text and a link."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "checkbox",
      "id": "banner_sticker",
      "label": "Show product sticker",
      "info": "The badge for the video's pinned product. It is placed opposite your text automatically, so it does not sit on the heading or the button.",
      "default": true
    },
    {
      "type": "select",
      "id": "preview_mode",
      "label": "Banner shows",
      "info": "The full video, autoplaying muted. A still image fetches no video at all, which is much lighter on a slow connection. Turn on Shuffle in the app to play through the widget's videos one after another instead of looping one.",
      "options": [
        { "value": "video", "label": "Playing video" },
        { "value": "image", "label": "Still image" }
      ],
      "default": "video"
    },
    {
      "type": "checkbox",
      "id": "lazy_load",
      "label": "Load only after the shopper interacts",
      "info": "Off by default, unlike the other layouts: a banner is usually the first thing on the page, and one that appears after the shopper moves the mouse reads as a glitch. Turn it on for a banner further down.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "banner_opens_player",
      "label": "Play full screen when tapped",
      "info": "Turn this off if the button is the only thing you want shoppers pressing — the video then stays decoration.",
      "default": true
    },
    {
      "type": "select",
      "id": "player_products",
      "label": "Products in the full-screen video",
      "info": "Ignored unless the banner opens full screen.",
      "options": [
        { "value": "sticker", "label": "Sticker on the video" },
        { "value": "free-scroll", "label": "Scrolling product row" },
        { "value": "hidden", "label": "Hidden" }
      ],
      "default": "sticker"
    }
  ]
}
{% endschema %}
