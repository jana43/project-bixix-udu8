{%- assign sje_key = 'widget_' | append: block.settings.widget_id -%}
{%- assign sje_widget = app.metafields.shoppable_videos[sje_key].value -%}
{%- assign sje_plan = app.metafields.shoppable_videos_plan.entitlements.value -%}
{%- assign sje_live = sje_widget.media | reject: 'deactivated', true | reject: 'enabled', false -%}
{%- assign sje_locked = true -%}{%- if sje_plan.layouts contains 'product-videos' -%}{%- assign sje_locked = false -%}{%- endif -%}
{%- assign sje_sp = 'var(--sje-standard-spacing, 8px)' -%}
{%- if block.settings.widget_id == blank -%}
  {% render 'sje-notice' %}
{%- elsif sje_widget == blank -%}
  {% render 'sje-notice', reason: 'not-found', widget_id: block.settings.widget_id %}
{%- elsif sje_widget.enabled == false -%}
  {% render 'sje-notice', reason: 'off', name: sje_widget.name %}
{%- elsif sje_locked -%}
  {% render 'sje-notice', reason: 'locked', name: sje_widget.name %}
{%- elsif sje_widget.deactivated -%}
  {% render 'sje-notice', reason: 'paused', name: sje_widget.name %}
{%- elsif sje_live.size == 0 -%}
  {% render 'sje-notice', reason: 'empty', name: sje_widget.name %}
{%- else -%}
  <div
    class="sje-widget sje-widget--product-videos sje-widget--pad-{{ block.settings.padding | default: 'none' }}"
    style="
      --sje-across-desktop:{{ block.settings.columns | default: 4 }};
      --sje-across-mobile:{{ block.settings.columns_mobile | default: 2 }};
      margin:calc({{ sje_sp }} * 3) auto;
    "
  >
    {%- if block.settings.show_heading != false -%}
      {%- assign sje_title = block.settings.heading | default: sje_widget.name -%}
      {% render 'sje-heading', text: sje_title, settings: block.settings %}
    {%- endif -%}
    {% render 'sje-mount',
      layout: 'product-videos',
      media: sje_live,
      script: 'sje-product-videos.js',
      widget_id: block.settings.widget_id,
      widget: sje_widget,
      settings: block.settings,
      product_id: product.id
    %}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Videos — Product row",
  "target": "section",
  "stylesheet": "sje-widget.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget ID",
      "info": "The 6-digit ID shown under the widget's name in the app."
    },
    {
      "type": "checkbox",
      "id": "shuffle",
      "label": "Shuffle videos",
      "info": "Play this widget's videos in a random order, different for every visitor. Overrides the order you arranged in the app.",
      "default": false
    },
    {
      "type": "select",
      "id": "product_filter",
      "label": "Which videos",
      "info": "This block knows which product the page is about, so it can favor that product's videos.",
      "options": [
        { "value": "tagged-first", "label": "This product's videos first" },
        { "value": "tagged", "label": "Only this product's videos" },
        { "value": "all", "label": "Every video in the widget" }
      ],
      "default": "tagged-first"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Padding",
      "info": "How much room the row leaves at the sides. None is usually right here — the theme's product section already has its own.",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "none", "label": "None" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the widget's name from the app."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading font size",
      "info": "A multiple of the widget's standard text size, so it scales down on phones along with everything else.",
      "min": 100,
      "max": 400,
      "step": 25,
      "unit": "x",
      "default": 175
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to use the theme's own heading color."
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards visible on desktop",
      "info": "Each card is that fraction of whatever width this block is given, so the row fits the theme's product column at any size. More cards means smaller ones.",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Cards visible on mobile",
      "info": "Set separately because it is a judgement, not arithmetic — nothing about four across a desktop says what a phone should do.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "info": "A multiple of the widget's standard spacing; 100 is 8px on a desktop, and 0 is square corners.",
      "min": 0,
      "max": 400,
      "step": 25,
      "unit": "x",
      "default": 100
    },
    {
      "type": "select",
      "id": "arrow_position",
      "label": "Scroll arrows",
      "info": "Where the arrows sit under the row. The row can always be swiped or dragged, whichever you choose.",
      "options": [
        { "value": "hidden", "label": "Hidden" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "arrow_scale",
      "label": "Arrow size",
      "info": "A multiple of the widget's standard spacing, so the arrows scale down on phones along with everything else.",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "x",
      "default": 400
    },
    {
      "type": "header",
      "content": "Videos"
    },
    {
      "type": "select",
      "id": "preview_mode",
      "label": "Card preview",
      "info": "Videos autoplay muted while the card is on screen. Images fetch nothing but the poster. Opening a card plays the full video either way.",
      "options": [
        { "value": "video", "label": "Playing video" },
        { "value": "image", "label": "Still image" }
      ],
      "default": "video"
    },
    {
      "type": "checkbox",
      "id": "lazy_load",
      "label": "Load cards only when user interact",
      "info": "On, nothing is downloaded until the shopper moves, taps or scrolls, and each card then waits until it is on screen. A product row usually sits below the fold, which is exactly where this pays.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticker_on_preview",
      "label": "Show product sticker on the cards",
      "info": "The product badge over each video. These cards are small, so the badge is at its least readable here — the full-screen player is set separately, below.",
      "default": false
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "player_products",
      "label": "Products in the full-screen video",
      "info": "How the video that opens when a shopper taps a card shows its tagged products.",
      "options": [
        { "value": "sticker", "label": "Sticker on the video" },
        { "value": "free-scroll", "label": "Scrolling product row" },
        { "value": "hidden", "label": "Hidden" }
      ],
      "default": "sticker"
    }
  ]
}
{% endschema %}
