{%- assign sje_key = 'widget_' | append: block.settings.widget_id -%}
{%- assign sje_widget = app.metafields.shoppable_videos[sje_key].value -%}
{%- assign sje_plan = app.metafields.shoppable_videos_plan.entitlements.value -%}
{%- assign sje_live = sje_widget.media | reject: 'deactivated', true | reject: 'enabled', false -%}
{%- assign sje_locked = true -%}{%- if sje_plan.layouts contains 'carousel' -%}{%- assign sje_locked = false -%}{%- endif -%}
{%- assign sje_sp = 'var(--sje-standard-spacing, 8px)' -%}
{%- if block.settings.widget_id == blank -%}
  {% render 'sje-notice' %}
{%- elsif sje_widget == blank -%}
  {% render 'sje-notice', reason: 'not-found', widget_id: block.settings.widget_id %}
{%- elsif sje_widget.enabled == false -%}
  {% render 'sje-notice', reason: 'off', name: sje_widget.name %}
{%- elsif sje_locked -%}
  {% render 'sje-notice', reason: 'locked', name: sje_widget.name %}
{%- elsif sje_widget.deactivated -%}
  {% render 'sje-notice', reason: 'paused', name: sje_widget.name %}
{%- elsif sje_live.size == 0 -%}
  {% render 'sje-notice', reason: 'empty', name: sje_widget.name %}
{%- else -%}
  <div
    class="sje-widget sje-widget--carousel sje-widget--pad-{{ block.settings.padding | default: 'medium' }}"
    style="height:70vh;display:flex;flex-direction:column;margin:calc({{ sje_sp }} * 3) auto;"
  >
    {%- if block.settings.show_heading != false -%}
      {% render 'sje-heading', text: sje_widget.name, settings: block.settings, flex: true %}
    {%- endif -%}
    <div class="sje-carousel__mount" style="flex:1 1 auto;min-height:0;">
      {% render 'sje-mount',
        layout: 'carousel',
        media: sje_live,
        script: 'sje-carousel.js',
        widget_id: block.settings.widget_id,
        widget: sje_widget,
        settings: block.settings
      %}
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Videos — Carousel",
  "target": "section",
  "stylesheet": "sje-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget ID",
      "info": "The 6-digit ID shown under the widget's name in the app."
    },
    {
      "type": "checkbox",
      "id": "shuffle",
      "label": "Shuffle videos",
      "info": "Play this widget's videos in a random order, different for every visitor. Overrides the order you arranged in the app.",
      "default": false
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Padding",
      "info": "How much room the widget leaves at the sides.",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "none", "label": "None" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "info": "The widget's name, from the app. Turn it off when the section around this block already has a title.",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading font size",
      "info": "A multiple of the widget's standard text size, so it scales down on phones along with everything else.",
      "min": 100,
      "max": 400,
      "step": 25,
      "unit": "x",
      "default": 175
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to use the theme's own heading color."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "info": "A multiple of the widget's standard spacing, so it stays in proportion on a phone rather than staying put while the card shrinks. 100 is 8px on a desktop; 0 is square corners.",
      "min": 0,
      "max": 400,
      "step": 25,
      "unit": "x",
      "default": 100
    },
    {
      "type": "select",
      "id": "arrow_position",
      "label": "Scroll arrows",
      "info": "Where the arrows sit under the row. The row can always be swiped or dragged, whichever you choose.",
      "options": [
        { "value": "hidden", "label": "Hidden" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "arrow_scale",
      "label": "Arrow size",
      "info": "As a percentage of the widget's standard spacing, so the arrows scale down on phones along with everything else.",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "x",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "sticker_on_preview",
      "label": "Show product sticker in preview video",
      "info": "The product badge over each video in the row. The full-screen player is set separately, below.",
      "default": true
    },
    {
      "type": "select",
      "id": "player_products",
      "label": "Products in the full-screen video",
      "info": "How the video that opens when a shopper taps a card shows its tagged products.",
      "options": [
        { "value": "sticker", "label": "Sticker on the video" },
        { "value": "free-scroll", "label": "Scrolling list" },
        { "value": "hidden", "label": "Hidden" }
      ],
      "default": "sticker"
    }
  ]
}
{% endschema %}
