{%- comment -%}
  Carousel: the widget's heading, and a mount point Preact renders the cards
  into.

  The Liquid here only ever draws chrome — heading, spacing, and the
  editor-only notices. Everything below the heading is `sje-carousel.js`,
  built from `extension/sje-shoppable-scripts` and lazy-loaded by
  `sje-mount`. There are no skeletons any more: the script fills the mount
  point on the first sign of a visitor.

  The widget comes from an app-data metafield on the app installation, which
  Liquid reaches through the `app` object. It is hidden from the admin and
  readable only by this app.
{%- endcomment -%}

{%- assign sje_key = 'widget_' | append: block.settings.widget_id -%}
{%- assign sje_widget = app.metafields.shoppable_videos[sje_key].value -%}

{%- comment -%}
  The two standard tokens, in the short form the sizes below are written
  against. Every size in this block is a multiple of one of them, never a bare
  number — see CLAUDE.md §3. The fallback literal inside `var()` is what keeps
  the block rendering at the desktop base if `sje-widget.css` fails to load.
{%- endcomment -%}
{%- assign sje_sp = 'var(--sje-standard-spacing, 8px)' -%}
{%- assign sje_fs = 'var(--sje-standard-font-size, 14px)' -%}

{%- if block.settings.widget_id == blank -%}
  {%- if request.design_mode -%}
    <div class="sje-widget__notice">
      Enter a Widget ID in this block&rsquo;s settings. You can find it under the
      widget&rsquo;s name in the Shoppable Videos app.
    </div>
  {%- endif -%}

{%- elsif sje_widget == blank -%}
  {%- if request.design_mode -%}
    <div class="sje-widget__notice">
      No widget found with ID {{ block.settings.widget_id }}. Check it against the ID in
      the Shoppable Videos app.
    </div>
  {%- endif -%}

{%- elsif sje_widget.enabled == false -%}
  {%- if request.design_mode -%}
    <div class="sje-widget__notice">
      &ldquo;{{ sje_widget.name }}&rdquo; is switched off, so it is hidden from shoppers.
      Turn on Active in the Shoppable Videos app to show it.
    </div>
  {%- endif -%}

{%- elsif sje_widget.mediaIds.size == 0 -%}
  {%- if request.design_mode -%}
    <div class="sje-widget__notice">
      &ldquo;{{ sje_widget.name }}&rdquo; has no videos yet, so there is nothing to show.
      Add some in the Shoppable Videos app.
    </div>
  {%- endif -%}

{%- else -%}
  {%- comment -%}
    The group is 70% of the viewport height, always. A column flex box holds
    that: the heading takes what it needs, the mount point takes the rest.
    `min-height:0` on the mount wrapper is required — a flex item defaults to
    `min-height:auto` and refuses to shrink below its content, which would
    push the group past 70vh.

    The measure comes from `sje-widget--pad-*` in the stylesheet, where it has
    to live: each step has a different width on mobile and a `style` attribute
    cannot carry a media query. The block margin is inline because this
    element's `style` beats the stylesheet, so a `margin-inline:auto` rule
    there would never win — and it is three standard spacings, so it tightens
    on a phone with everything else. The 70vh is left alone: a viewport unit is
    already relative, and pinning it to a px token would make the group LESS
    responsive, not more.
  {%- endcomment -%}
  <div
    class="sje-widget sje-widget--carousel sje-widget--pad-{{ block.settings.padding | default: 'medium' }}"
    style="height:70vh;display:flex;flex-direction:column;margin:calc({{ sje_sp }} * 3) auto;"
  >
    {%- if sje_widget.name != blank -%}
      {%- comment -%}
        The colour is only emitted when the merchant actually picked one. A
        `color` setting left alone comes back blank, and always writing one
        would stop the heading inheriting the theme's own colour.
      {%- endcomment -%}
      {%- comment -%}
        The merchant's size feeds a TOKEN, not `font-size` directly, so the
        heading is derived from the standard scale like everything else. The
        setting is a percentage — 175 means 1.75x the standard font size — so
        the heading now shrinks on a phone with the rest of the widget, which
        an absolute px never did.
      {%- endcomment -%}
      {%- assign heading_mult = block.settings.heading_scale | default: 175 | divided_by: 100.0 -%}
      <h2
        class="sje-widget__heading"
        style="
          --sje-heading-font-size:calc({{ sje_fs }} * {{ heading_mult }});
          flex:0 0 auto;
          margin:0 0 calc({{ sje_sp }} * 1.5);
          text-align:{{ block.settings.heading_alignment | default: 'left' }};
          font-size:var(--sje-heading-font-size);
          {%- if block.settings.heading_color != blank -%}
            color:{{ block.settings.heading_color }};
          {%- endif -%}
        "
      >{{ sje_widget.name }}</h2>
    {%- endif -%}

    <div style="flex:1 1 auto;min-height:0;">
      {% render 'sje-mount',
        layout: 'carousel',
        script: 'sje-carousel.js',
        widget_id: block.settings.widget_id,
        widget: sje_widget,
        settings: block.settings
      %}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Videos — Carousel",
  "target": "section",
  "stylesheet": "sje-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget ID",
      "info": "The 6-digit ID shown under the widget's name in the app."
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Padding",
      "info": "How much room the widget leaves at the sides.",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "none", "label": "None" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading font size",
      "info": "As a percentage of the widget's standard text size, so it scales down on phones along with everything else.",
      "min": 100,
      "max": 400,
      "step": 25,
      "unit": "%",
      "default": 175
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to use the theme's own heading color."
    },
    {
      "type": "select",
      "id": "arrow_position",
      "label": "Scroll arrows",
      "info": "Where the arrows sit under the row. The row can always be swiped or dragged, whichever you choose.",
      "options": [
        { "value": "hidden", "label": "Hidden" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "arrow_scale",
      "label": "Arrow size",
      "info": "As a percentage of the widget's standard spacing, so the arrows scale down on phones along with everything else.",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "%",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "sticker_on_preview",
      "label": "Show product sticker in preview video",
      "info": "The product badge over each video in the row. The full-screen player is set separately, below.",
      "default": true
    },
    {
      "type": "select",
      "id": "player_products",
      "label": "Products in the full-screen video",
      "info": "How the video that opens when a shopper taps a card shows its tagged products.",
      "options": [
        { "value": "sticker", "label": "Sticker on the video" },
        { "value": "free-scroll", "label": "Scrolling list" },
        { "value": "hidden", "label": "Hidden" }
      ],
      "default": "sticker"
    }
  ]
}
{% endschema %}
